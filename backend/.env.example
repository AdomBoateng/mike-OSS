PORT=3001

# CORS allowlist: the exact origin(s) allowed to call this API, comma-separated.
# "*" reflects any origin — convenient for LAN access by server IP, but do not
# use it on an internet-facing deployment. docker-compose.yml sets this to "*";
# docker-compose.prod.yml pins it to APP_PUBLIC_URL.
FRONTEND_URL=http://localhost:3000

# The address users actually browse to. Used for absolute links in outbound
# email — FRONTEND_URL cannot serve that purpose because it may be a list or "*".
APP_PUBLIC_URL=http://localhost:3000

# Set to "production" for a real deployment. This turns on HSTS and makes the
# backend refuse to start when a required secret below is missing or still holds
# its placeholder value (see src/lib/config.ts).
NODE_ENV=development

# Number of reverse-proxy hops in front of the app, for client-IP detection
# (rate limiting keys on it). 0 when nothing proxies the backend.
# TRUST_PROXY_HOPS=1

# Serve the API under a path prefix. Empty (the default) means routes are at the
# root, which is what docker-compose does: the two apps are on separate ports.
#
# Set it to "/api" when a single hostname carries both apps and an ingress sends
# /api here — the Kubernetes shape (docs/KUBERNETES.md). The backend strips the
# prefix itself, so no controller-specific rewrite rule is needed, and because
# the browser is then on the same origin there is no CORS and no second port to
# open. It must match API_BASE_URL in the FRONTEND's environment.
# API_BASE_PATH=/api

# --- Secrets (all three are required) --------------------------------------
# Generate each one separately:  openssl rand -hex 32

# HMAC key used to sign /download/:token URLs.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
# Signing key for our own session JWTs (issued after an LDAP bind).
# Rotating this invalidates every active session.
SESSION_JWT_SECRET=replace-with-a-random-32-byte-hex-string
# Encrypts per-user API keys and TOTP secrets at rest (AES-256-GCM).
# Rotating this makes stored keys and enrolled authenticators unreadable.
USER_API_KEYS_ENCRYPTION_SECRET=replace-with-a-random-32-byte-hex-string

# Self-hosted Postgres. Matches the credentials in docker-compose.yml; the
# compose file overrides this for the container network.
DATABASE_URL=postgres://mike:mike_local_dev@localhost:5433/mike

# LDAP authentication (external directory, e.g. FreeIPA).
LDAP_URL=ldap://your-ldap-host:389
LDAP_SEARCH_BIND_DN=uid=serviceaccount,cn=users,cn=accounts,dc=example,dc=com
LDAP_SEARCH_BIND_PASSWORD=your-search-bind-password
LDAP_USER_BASE_DN=cn=users,cn=accounts,dc=example,dc=com
# Optional overrides (defaults shown):
# LDAP_USERNAME_ATTRIBUTE=uid
# LDAP_MAIL_ATTRIBUTE=mail
# Attribute(s) holding the user's organisation (shown read-only in the app).
# Comma-separated, first populated wins. Defaults to "o,ou" — commonly "o"
# (organizationName) or "ou" (organizationalUnit).
# LDAP_ORG_ATTRIBUTE=o,ou
# LDAP_OPERATION_TIMEOUT_MS=10000
# At startup the backend binds as the search account above, so an unroutable
# directory stops the process instead of surfacing when someone tries to sign
# in. Fatal in production, a warning otherwise; "warn" starts anyway, "off"
# skips the check. See docs/DEPLOYMENT.md for the Docker subnet caveat.
# LDAP_STARTUP_PROBE=fatal

# S3-compatible object storage (self-hosted "surf" / MinIO, AWS S3, or R2).
# The legacy R2_* names are still accepted as a fallback.
S3_ENDPOINT_URL=https://s3.your-domain.internal
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=mike
# Optional: defaults to "auto".
# S3_REGION=auto
# Optional: set to "false" for virtual-hosted-style URLs (default is path-style).
# S3_FORCE_PATH_STYLE=true
# Optional: fail fast if storage is unreachable (ms). TCP connect + socket-idle.
# S3_CONNECT_TIMEOUT_MS=5000
# S3_REQUEST_TIMEOUT_MS=60000
# At startup the backend does a HeadBucket against the endpoint above, so a
# deployment with no route to the storage network fails at boot instead of on a
# user's first upload. Unreachable storage is fatal in production and a warning
# otherwise; set this to override. "warn" starts anyway, "off" skips the check.
# STORAGE_STARTUP_PROBE=fatal

# Outbound email (project collaborator invitations) via SMTP.
# Point these at the self-hosted Zimbra instance. If SMTP_HOST or SMTP_FROM is
# unset, invitation emails are skipped (sharing still works).
SMTP_HOST=mail.your-domain.internal
# 587 = STARTTLS submission (SMTP_SECURE=false); 465 = implicit TLS (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-domain.internal
SMTP_PASS=your-smtp-password
SMTP_FROM=Mike <no-reply@your-domain.internal>

# --- Models -----------------------------------------------------------------
# The app serves models from a self-hosted OpenAI-compatible endpoint (vLLM)
# ONLY; the Anthropic/Google/OpenAI pickers were removed. This is required for
# the assistant to work at all.
#
# CUSTOM_LLM_BASE_URL is the OpenAI-compatible root — models are read from
# {CUSTOM_LLM_BASE_URL}/models and served under a "Custom" group in the picker.
# Both act as instance-wide defaults a user can override per account under
# Account > Models & API Keys.
#
# Display names for known model ids are mapped in src/lib/llm/models.ts
# (e.g. qwen3_6_35b -> "Qwen3.6-35b"); unmapped ids show their raw id.
CUSTOM_LLM_BASE_URL=http://your-vllm-host:8000/v1
CUSTOM_LLM_API_KEY=your-vllm-api-key
# vLLM closes the socket mid-request when its engine restarts. The request is
# retried when that happens, but only while nothing has been streamed to the
# browser yet — replaying after output would write the answer out twice.
# CUSTOM_LLM_STREAM_RETRIES=3
# CUSTOM_LLM_STREAM_RETRY_DELAY_MS=1000
# Inactivity timeout for a streaming response, in ms. Node's default is 300s,
# which kills a long generation (redrafting a whole contract) while the model
# is still working — it surfaces as "terminated" after a partial answer. 30
# minutes here; the request is still cancellable, this only stops a live but
# slow stream being cut off.
# CUSTOM_LLM_BODY_TIMEOUT_MS=1800000
# CUSTOM_LLM_HEADERS_TIMEOUT_MS=120000

# Long sessions eventually outgrow the model's context window. The oldest turns
# are folded into a summary before that happens; the recent ones are kept
# verbatim and the system prompt is never touched. The window cannot be
# detected (vLLM's /models does not report max_model_len), so set it to match
# the model you serve. Token counts are estimated from character length and
# deliberately run high, so compaction happens a little early.
# CONTEXT_WINDOW_TOKENS=32768
# CONTEXT_COMPACT_AT=0.7          # fraction of the window that triggers it
# CONTEXT_KEEP_RECENT_TURNS=6     # turns always kept word-for-word

# Optional legacy cloud providers. Nothing in the UI offers these models any
# more; keys are only read if a stored model id from before the cutover is
# still selected. Leave unset for a self-hosted-only deployment.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token

# Ghana primary legislation, from the Parliament of Ghana Library Repository
# (DSpace). The API is open, so no key is needed and nothing has to be set here.
# Extracted text is cached in the S3 bucket under "ghana-law/items/" — a cold
# fetch downloads and extracts a PDF and can take 20s+, so storage being
# configured matters more for this source than for most.
# GHANA_LAW_ENABLED=true
# GHANA_LAW_BASE_URL=https://repository.parliament.gh/server/api
# GHANA_LAW_REQUEST_TIMEOUT_MS=30000
# GHANA_LAW_DOWNLOAD_TIMEOUT_MS=120000
# GHANA_LAW_MAX_PDF_BYTES=26214400

# Open-web search, via a SearXNG instance you run yourself. Unset means the
# tool is never offered — there is deliberately no public fallback, because
# falling back would send the firm's queries to a third party, which is the
# whole reason for choosing SearXNG.
#
# The instance MUST have the JSON format enabled, which a default install does
# not: add "json" to search.formats in its settings.yml, or every search comes
# back 403.
# SEARXNG_BASE_URL=http://searxng.your-domain.internal:8080
# SEARXNG_REQUEST_TIMEOUT_MS=15000
# WEB_SEARCH_ENABLED=true      # instance-wide kill switch; per-user toggle
                               # lives in Account > Features.

# OCR for scanned legislation. About a third of the Ghana corpus is image-only
# with no text layer; those pages are rasterised with pdftoppm (poppler-utils,
# shipped in the backend image) and transcribed by the multimodal model behind
# CUSTOM_LLM_BASE_URL. The result is marked as OCR so it is never mistaken for
# an authentic text layer. Requires no extra credentials.
# OCR_ENABLED=true
# PDFTOPPM_BINARY_PATH=            # only if pdftoppm is not on PATH
# OCR_DPI=150                      # rasterisation resolution
# OCR_MAX_PAGES=12                 # pages transcribed per request
# OCR_CONCURRENCY=4                # pages transcribed in parallel

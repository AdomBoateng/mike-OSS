PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Self-hosted Postgres (docker-compose.yml). Used by the LDAP/Postgres
# migration (Phase 3). Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://mike:mike_local_dev@localhost:5433/mike

# Session tokens (our own JWTs, replacing Supabase-issued ones).
# Generate with: openssl rand -hex 32
SESSION_JWT_SECRET=replace-with-a-random-32-byte-hex-string

# LDAP authentication (external directory, e.g. FreeIPA).
LDAP_URL=ldap://your-ldap-host:389
LDAP_SEARCH_BIND_DN=uid=serviceaccount,cn=users,cn=accounts,dc=example,dc=com
LDAP_SEARCH_BIND_PASSWORD=your-search-bind-password
LDAP_USER_BASE_DN=cn=users,cn=accounts,dc=example,dc=com
# Optional overrides (defaults shown):
# LDAP_USERNAME_ATTRIBUTE=uid
# LDAP_MAIL_ATTRIBUTE=mail
# Attribute holding the user's organisation (shown read-only in the app).
# Commonly "o" (organizationName) or "ou" (organizationalUnit).
# LDAP_ORG_ATTRIBUTE=o
# LDAP_OPERATION_TIMEOUT_MS=10000

# S3-compatible object storage (self-hosted "surf" / MinIO, AWS S3, or R2).
# The legacy R2_* names are still accepted as a fallback.
S3_ENDPOINT_URL=https://s3.your-domain.internal
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=mike
# Optional: defaults to "auto".
# S3_REGION=auto
# Optional: set to "false" for virtual-hosted-style URLs (default is path-style).
# S3_FORCE_PATH_STYLE=true

# Outbound email (project collaborator invitations) via SMTP.
# Point these at the self-hosted Zimbra instance. If SMTP_HOST or SMTP_FROM is
# unset, invitation emails are skipped (sharing still works).
SMTP_HOST=mail.your-domain.internal
# 587 = STARTTLS submission (SMTP_SECURE=false); 465 = implicit TLS (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-domain.internal
SMTP_PASS=your-smtp-password
SMTP_FROM=Mike <no-reply@your-domain.internal>

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
RESEND_API_KEY=your-resend-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token
